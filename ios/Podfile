platform :ios, '15.0'

use_modular_headers!

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end

  pod 'gRPC-Core', :modular_headers => false
  pod 'gRPC-C++', :modular_headers => false
  pod 'BoringSSL-GRPC', :modular_headers => false
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
      config.build_settings['CODE_SIGN_STYLE'] = 'Manual'
      config.build_settings['DEVELOPMENT_TEAM'] = ''
      definitions = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
      definitions = [definitions] if definitions.is_a?(String)
      definitions ||= ['$(inherited)']
      definitions << 'PERMISSION_CAMERA=1'
      definitions << 'PERMISSION_MICROPHONE=1'
      definitions << 'PERMISSION_PHOTOS=1'
      definitions << 'FIR_RECAPTCHA_PROVIDER_SWIFT_AVAILABLE=0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions.uniq
    end
  end

  # Fix: Ensure gRPC-Core.modulemap exists in Private/Public headers for Clang
  grpc_source = File.join(installer.sandbox.root, 'Target Support Files', 'gRPC-Core', 'gRPC-Core.modulemap')
  [
    File.join(installer.sandbox.root, 'Headers', 'Private', 'grpc'),
    File.join(installer.sandbox.root, 'Headers', 'Public', 'grpc')
  ].each do |dir|
    FileUtils.mkdir_p(dir)
    target_file = File.join(dir, 'gRPC-Core.modulemap')
    if File.exist?(grpc_source)
      FileUtils.cp_r(grpc_source, target_file)
    else
      File.write(target_file, "module \"gRPC-Core\" {\n  export *\n}\n")
    end
  end

  # Fix: Replace FIRRecaptchaProvider.m with clean stub to avoid missing GACRecaptchaProvider Swift symbol
  recaptcha_m = File.join(installer.sandbox.root, 'FirebaseAppCheck', 'FirebaseAppCheck', 'Sources', 'RecaptchaProvider', 'FIRRecaptchaProvider.m')
  if File.exist?(recaptcha_m)
    File.chmod(0644, recaptcha_m)
    File.write(recaptcha_m, <<~OBJC
      #import "FirebaseAppCheck/Sources/Public/FirebaseAppCheck/FIRRecaptchaProvider.h"

      @implementation FIRRecaptchaProvider

      + (BOOL)isSupported {
        return NO;
      }

      - (nullable instancetype)initWithApp:(FIRApp *)app siteKey:(NSString *)siteKey {
        return nil;
      }

      - (void)getTokenWithCompletion:(void (^)(FIRAppCheckToken *_Nullable token, NSError *_Nullable error))handler {
        if (handler) {
          handler(nil, [NSError errorWithDomain:@"FIRRecaptchaProvider" code:-1 userInfo:nil]);
        }
      }

      - (void)getLimitedUseTokenWithCompletion:(void (^)(FIRAppCheckToken *_Nullable token, NSError *_Nullable error))handler {
        [self getTokenWithCompletion:handler];
      }

      @end
    OBJC
    )
  end

  # Fix: Create framework wrapper for FirebaseFirestoreInternal to satisfy -(weak_)framework FirebaseFirestoreInternal
  firestore_target = installer.pods_project.targets.find { |t| t.name == 'FirebaseFirestoreInternal' }
  if firestore_target
    phase_name = 'Create Framework Wrapper'
    existing = firestore_target.shell_script_build_phases.find { |p| p.name == phase_name }
    unless existing
      phase = firestore_target.new_shell_script_build_phase(phase_name)
      phase.shell_script = <<~'SCRIPT'
        set -e
        echo "Creating FirebaseFirestoreInternal.framework wrapper..."
        LIB=""
        for candidate in "${TARGET_BUILD_DIR}/${EXECUTABLE_NAME}" "${BUILT_PRODUCTS_DIR}/libFirebaseFirestoreInternal.a" "${BUILT_PRODUCTS_DIR}/FirebaseFirestoreInternal/libFirebaseFirestoreInternal.a"; do
          if [ -f "$candidate" ]; then
            LIB="$candidate"
            break
          fi
        done
        if [ -z "$LIB" ]; then
          LIB=$(find "${SYMROOT}" "${BUILD_DIR}" "${BUILT_PRODUCTS_DIR}" -name "libFirebaseFirestoreInternal.a" 2>/dev/null | head -n 1)
        fi
        echo "Found static library: $LIB"
        for dir in "${BUILT_PRODUCTS_DIR}" "${BUILT_PRODUCTS_DIR}/FirebaseFirestoreInternal" "${TARGET_BUILD_DIR}"; do
          if [ -d "$dir" ]; then
            FW="$dir/FirebaseFirestoreInternal.framework"
            mkdir -p "$FW"
            if [ -n "$LIB" ] && [ -f "$LIB" ]; then
              cp -f "$LIB" "$FW/FirebaseFirestoreInternal"
            fi
            cat << 'PLIST' > "$FW/Info.plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>org.cocoapods.FirebaseFirestoreInternal</string>
    <key>CFBundleName</key>
    <string>FirebaseFirestoreInternal</string>
    <key>CFBundlePackageType</key>
    <string>FMWK</string>
</dict>
</plist>
PLIST
          fi
        done
        echo "✅ Created FirebaseFirestoreInternal.framework wrapper"
      SCRIPT
    end
  end

  # Fix: Replace -(weak_)framework "FirebaseFirestoreInternal" with -l"FirebaseFirestoreInternal" everywhere
  targets_to_patch = Dir.glob(File.join(installer.sandbox.root, '**', '*.xcconfig')) + [File.join(installer.sandbox.root, 'Pods.xcodeproj', 'project.pbxproj')]
  targets_to_patch.each do |file|
    next unless File.exist?(file)
    text = File.read(file)
    if text.match?(/-(?:weak_)?framework\s+["']?FirebaseFirestoreInternal["']?/)
      text = text.gsub(/-(?:weak_)?framework\s+["']?FirebaseFirestoreInternal["']?/, '-l"FirebaseFirestoreInternal"')
      File.write(file, text)
      puts "✅ Patched #{file}: replaced -(weak_)framework FirebaseFirestoreInternal with -lFirebaseFirestoreInternal"
    end
  end
end
