rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profils utilisateurs : l'utilisateur ne peut pas modifier ses pièces, VIP, niveau, XP ni stats directement
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.coins == 50
                    && request.resource.data.isPremium == false
                    && request.resource.data.level == 1
                    && request.resource.data.xp == 0;
      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'coins', 'level', 'xp', 'gameStats'])) ||
        (request.auth.uid != userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendRequests', 'gameInvites']))
      );
      allow delete: if false;
    }

    // Matchmaking
    match /matchmaking/{docId} {
      allow read, write: if request.auth != null;
    }

    // Salons (Lounges)
    match /lounges/{loungeId} {
      allow read, write: if request.auth != null;
      match /chat/{msgId} {
        allow read, write: if request.auth != null;
      }
      match /presences/{pId} {
        allow read, write: if request.auth != null && request.auth.uid == pId;
      }
    }

    // Parties (Games)
    match /games/{gameCode} {
      allow read, create: if request.auth != null;
      // Seul l'hôte légitime ou un participant authentifié peut déclarer la fin de partie (gameState == gameOver)
      allow update: if request.auth != null 
        && (
          request.resource.data.gameState != "gameOver"
          || resource.data.hostId == request.auth.uid
          || (resource.data.players[request.auth.uid] != null && resource.data.players[request.auth.uid].authUid == request.auth.uid)
        );
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;

      // Données secrètes de joueur (Rôles secrets, cartes cachées, grilles privées) : accessible uniquement par le joueur concerné
      match /privatePlayerData/{pId} {
        allow read: if request.auth != null && request.auth.uid == pId;
        allow write: if request.auth != null;
      }

      match /private_data/{targetPlayerId} {
        allow read: if request.auth != null && (
          request.auth.uid == targetPlayerId || 
          resource.data.authUid == request.auth.uid
        );
        allow write: if request.auth != null;
      }

      match /presences/{pId} {
        allow read, write: if request.auth != null;
      }

      // Sous-collections privées (Just One & Petit Bac) : accès strict au propriétaire
      match /just_one_private_clues/{playerId} {
        allow write: if request.auth != null && request.auth.uid == playerId;
        allow read: if request.auth != null && (
          request.auth.uid == playerId || 
          get(/databases/$(database)/documents/games/$(gameCode)).data.roundState == 'reveal_clues'
        );
      }

      match /petit_bac_private_answers/{playerId} {
        allow write: if request.auth != null && request.auth.uid == playerId;
        allow read: if request.auth != null && (
          request.auth.uid == playerId || 
          get(/databases/$(database)/documents/games/$(gameCode)).data.roundState == 'round_results'
        );
      }

      match /chat/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // Signalements UGC (Reports)
    match /reports/{reportId} {
      allow create: if request.auth != null 
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() < 1000;
      allow read, update, delete: if false; // Accessible uniquement via console Firebase
    }
  }
}

