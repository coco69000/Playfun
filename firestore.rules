rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // 1. PROFILS UTILISATEURS
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Un utilisateur ne peut pas modifier son statut VIP ni son solde de pièces en direct
      allow update: if isOwner(userId) 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'coins']);
        
      allow create: if isOwner(userId);
      allow delete: if false; // Géré uniquement par la Cloud Function deleteUserAccount

      match /ai_history/{historyId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==========================================
    // 2. MATCHMAKING
    // ==========================================
    match /matchmaking/{docId} {
      allow read, write, create, delete: if isAuthenticated();
    }

    // ==========================================
    // 3. SESSIONS DE JEU (GAMES)
    // ==========================================
    match /games/{gameCode} {
      allow read: if isAuthenticated();
      
      // Empêcher l'injection de triche sur les récompenses et la validation forcée
      allow update: if isAuthenticated() 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['claimedRewards']);
        
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();

      match /chat/{chatId} {
        allow read, write: if isAuthenticated();
      }

      match /presences/{presenceId} {
        allow read, write: if isAuthenticated();
      }

      match /private_data/{docId} {
        // Données privées (mot du civil/infiltré, cartes cachées) accessibles au détenteur
        allow read: if isOwner(docId) || (resource != null && resource.data.authUid == request.auth.uid);
        allow write: if isAuthenticated();
      }

      match /privatePlayerData/{pId} {
        allow read: if isOwner(pId);
        allow write: if isAuthenticated();
      }

      match /just_one_private_clues/{playerId} {
        allow read, write: if isAuthenticated();
      }

      match /petit_bac_private_answers/{playerId} {
        allow read: if isOwner(playerId);
        allow write: if isAuthenticated();
      }
    }

    // ==========================================
    // 4. SALONS (LOUNGES)
    // ==========================================
    match /lounges/{loungeId} {
      allow read, write, create, delete: if isAuthenticated();

      match /chat/{chatId} {
        allow read, write: if isAuthenticated();
      }

      match /presences/{presenceId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ==========================================
    // 5. SIGNALEMENTS UGC (REPORTS)
    // ==========================================
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false; // Accessible uniquement via console Firebase / Admin SDK
    }

    // ==========================================
    // 6. CONFIGURATION DE VERSION & MAINTENANCE (Lecture seule publique)
    // 6. MESSAGES DIRECTS ENTRE AMIS (DIRECT CHATS)
    // ==========================================
    match /direct_chats/{chatId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ==========================================
    // 7. CONFIGURATION DE VERSION & MAINTENANCE (Lecture seule publique)
    // ==========================================
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
